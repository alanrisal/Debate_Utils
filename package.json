{
  "name": "flowkit",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",

  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder"
  },

  "dependencies": {
    "dotenv": "^17.3.1",
    "electron-store": "^11.0.2",
    "fuse.js": "^7.1.0",
    "googleapis": "^171.4.0",
    "mammoth": "^1.11.0"
  },

  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "svelte": "^5.45.2",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  },

  "build": {
    "appId": "com.flowkit.app",
    "productName": "FlowKit",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  }
}
